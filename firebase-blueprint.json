{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profile in ALLORA representing a community member",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "professionalTitle": { "type": "string", "maxLength": 100 },
        "profession": { "type": "string", "maxLength": 100 },
        "phoneNumber": { "type": "string", "maxLength": 50 },
        "birthDate": { "type": "string", "maxLength": 50 },
        "bio": { "type": "string", "maxLength": 1000 },
        "location": { "type": "string", "maxLength": 150 },
        "availability": { "type": "string", "maxLength": 100 },
        "skills": { "type": "array" },
        "servicesOffered": { "type": "array" },
        "interests": { "type": "array" },
        "churchIds": { "type": "array" },
        "photoUrl": { "type": "string", "maxLength": 1048576 },
        "coverPhotoUrl": { "type": "string", "maxLength": 1048576 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email", "displayName"]
    },
    "churches": {
      "title": "Church",
      "description": "Church profile and community information",
      "type": "object",
      "properties": {
        "churchId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "coverImageUrl": { "type": "string", "maxLength": 500 },
        "address": { "type": "string", "maxLength": 250 },
        "city": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "contactPhone": { "type": "string", "maxLength": 50 },
        "contactEmail": { "type": "string", "maxLength": 100 },
        "website": { "type": "string", "maxLength": 150 },
        "denomination": { "type": "string", "maxLength": 100 },
        "foundedYear": { "type": "string", "maxLength": 10 },
        "joinCode": { "type": "string", "maxLength": 50 },
        "leaderIds": { "type": "array" },
        "verified": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["churchId", "name", "city", "country", "joinCode", "leaderIds", "verificationStatus", "createdBy", "createdAt"]
    },
    "churchMembers": {
      "title": "Church Member",
      "description": "Membership association between users and churches with permission roles",
      "type": "object",
      "properties": {
        "membershipId": { "type": "string", "maxLength": 256 },
        "churchId": { "type": "string", "maxLength": 128 },
        "churchName": { "type": "string", "maxLength": 150 },
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 256 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["OWNER", "ADMIN", "MEMBER"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "left", "removed"] },
        "joinCode": { "type": "string", "maxLength": 50 },
        "joinedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["membershipId", "churchId", "churchName", "userId", "displayName", "email", "role", "status", "joinedAt", "updatedAt"]
    },
    "notifications": {
      "title": "Church Notification",
      "description": "In-app community notification for multiple events",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 1000 },
        "churchId": { "type": "string", "maxLength": 128 },
        "churchName": { "type": "string", "maxLength": 150 },
        "relatedId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["membership_request", "membership_approved", "membership_rejected", "role_changed", "info", "needs", "resources", "collaborations", "churches", "events", "community", "opportunities", "system"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["notificationId", "userId", "title", "body", "type", "read", "createdAt"]
    },
    "posts": {
      "title": "Community Post",
      "description": "Community announcement or sharing post",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhotoUrl": { "type": "string", "maxLength": 500 },
        "churchId": { "type": "string", "maxLength": 128 },
        "churchName": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "enum": ["announcement", "community", "testimony", "information", "opportunity", "other"] },
        "visibility": { "type": "string", "enum": ["public", "church", "private"] },
        "status": { "type": "string", "enum": ["published", "archived"] },
        "reactions": { "type": "object" },
        "commentCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["postId", "authorId", "title", "content", "category", "visibility", "status", "createdAt", "updatedAt"]
    },
    "comments": {
      "title": "Post Comment",
      "description": "User comment on a community post",
      "type": "object",
      "properties": {
        "commentId": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhotoUrl": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["commentId", "postId", "authorId", "authorName", "content", "createdAt", "updatedAt"]
    },
    "opportunities": {
      "title": "Professional Opportunity",
      "description": "Professional opportunity, job offer, volunteer position, service offering, or skill request",
      "type": "object",
      "properties": {
        "opportunityId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["service", "job", "volunteer", "skill_request"] },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 100 },
        "skills": { "type": "array" },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhotoUrl": { "type": "string", "maxLength": 500 },
        "authorTitle": { "type": "string", "maxLength": 100 },
        "churchId": { "type": "string", "maxLength": 128 },
        "churchName": { "type": "string", "maxLength": 150 },
        "location": { "type": "string", "maxLength": 250 },
        "visibility": { "type": "string", "enum": ["public", "church", "private"] },
        "status": { "type": "string", "enum": ["open", "closed", "filled", "cancelled"] },
        "availability": { "type": "string", "maxLength": 100 },
        "compensation": { "type": "string", "maxLength": 100 },
        "responseCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["opportunityId", "type", "title", "description", "category", "skills", "authorId", "location", "visibility", "status", "createdAt", "updatedAt"]
    },
    "opportunityResponses": {
      "title": "Opportunity Response / Application",
      "description": "User interest or application for an opportunity",
      "type": "object",
      "properties": {
        "responseId": { "type": "string", "maxLength": 128 },
        "opportunityId": { "type": "string", "maxLength": 128 },
        "opportunityTitle": { "type": "string", "maxLength": 200 },
        "opportunityAuthorId": { "type": "string", "maxLength": 128 },
        "responderId": { "type": "string", "maxLength": 128 },
        "responderName": { "type": "string", "maxLength": 100 },
        "responderPhotoUrl": { "type": "string", "maxLength": 500 },
        "responderTitle": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 2000 },
        "skills": { "type": "array" },
        "contactEmail": { "type": "string", "maxLength": 256 },
        "contactPhone": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "withdrawn"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["responseId", "opportunityId", "opportunityAuthorId", "responderId", "responderName", "message", "status", "createdAt", "updatedAt"]
    },
    "needs": {
      "title": "Need",
      "description": "Community need or request for help / resource",
      "type": "object",
      "properties": {
        "needId": { "type": "string", "maxLength": 128 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "churchId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 100 },
        "subcategory": { "type": "string", "maxLength": 100 },
        "location": { "type": "object" },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 50 },
        "neededFrom": { "type": "string" },
        "neededUntil": { "type": "string" },
        "urgency": { "type": "string", "enum": ["low", "normal", "high", "urgent"] },
        "status": { "type": "string", "enum": ["open", "partially_fulfilled", "fulfilled", "cancelled", "expired"] },
        "visibility": { "type": "string", "enum": ["public", "church", "private"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["needId", "createdBy", "title", "description", "category", "subcategory", "location", "quantity", "unit", "neededFrom", "urgency", "status", "visibility", "createdAt", "updatedAt"]
    },
    "resources": {
      "title": "Resource",
      "description": "Shared resource, equipment, loan, skill, or service",
      "type": "object",
      "properties": {
        "resourceId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerType": { "type": "string", "enum": ["user", "church"] },
        "churchId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 100 },
        "subcategory": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["loan", "donation", "service", "volunteer"] },
        "location": { "type": "object" },
        "availability": { "type": "string", "maxLength": 150 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 50 },
        "availableFrom": { "type": "string" },
        "availableUntil": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "reserved", "unavailable", "closed"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["resourceId", "ownerId", "ownerType", "title", "description", "category", "subcategory", "type", "location", "availability", "quantity", "unit", "status", "createdAt", "updatedAt"]
    },
    "needResponses": {
      "title": "Need Response",
      "description": "User proposal responding to an active community need",
      "type": "object",
      "properties": {
        "responseId": { "type": "string", "maxLength": 128 },
        "needId": { "type": "string", "maxLength": 128 },
        "needAuthorId": { "type": "string", "maxLength": 128 },
        "resourceId": { "type": "string", "maxLength": 128 },
        "responderId": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 1000 },
        "quantityProposed": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "withdrawn"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["responseId", "needId", "needAuthorId", "responderId", "message", "status", "createdAt", "updatedAt"]
    },
    "events": {
      "title": "Community Event",
      "description": "Community or church gathering and service event for Phase 5",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 3000 },
        "category": { "type": "string", "maxLength": 100 },
        "organizerType": { "type": "string", "enum": ["user", "church"] },
        "organizerId": { "type": "string", "maxLength": 128 },
        "churchId": { "type": "string", "maxLength": 128 },
        "location": { "type": "string", "maxLength": 250 },
        "startAt": { "type": "string" },
        "endAt": { "type": "string" },
        "capacity": { "type": "number" },
        "visibility": { "type": "string", "enum": ["public", "church", "private"] },
        "status": { "type": "string", "enum": ["draft", "published", "cancelled", "completed"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["eventId", "title", "description", "category", "organizerType", "organizerId", "location", "startAt", "endAt", "visibility", "status", "createdAt", "updatedAt"]
    },
    "eventParticipants": {
      "title": "Event Participant",
      "description": "User registration record for community events",
      "type": "object",
      "properties": {
        "participantId": { "type": "string", "maxLength": 256 },
        "eventId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["registered", "cancelled", "attended"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["participantId", "eventId", "userId", "status", "createdAt", "updatedAt"]
    },
    "collaborations": {
      "title": "Collaboration",
      "description": "Joint inter-church collaboration project or concrete matching transaction between need and resource",
      "type": "object",
      "properties": {
        "collaborationId": { "type": "string", "maxLength": 128 },
        "needId": { "type": "string", "maxLength": 128 },
        "resourceId": { "type": "string", "maxLength": 128 },
        "needOwnerId": { "type": "string", "maxLength": 128 },
        "resourceOwnerId": { "type": "string", "maxLength": 128 },
        "churchId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["draft", "proposed", "accepted", "active", "completed", "cancelled", "rejected", "archived"] },
        "quantity": { "type": "number" },
        "message": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 3000 },
        "needTitle": { "type": "string", "maxLength": 200 },
        "resourceTitle": { "type": "string", "maxLength": 200 },
        "needOwnerName": { "type": "string", "maxLength": 100 },
        "resourceOwnerName": { "type": "string", "maxLength": 100 },
        "churchName": { "type": "string", "maxLength": 150 },
        "leadChurchId": { "type": "string", "maxLength": 128 },
        "churchIds": { "type": "array" },
        "leaderIds": { "type": "array" }
      },
      "required": ["collaborationId", "needId", "resourceId", "needOwnerId", "resourceOwnerId", "status", "quantity", "message", "createdAt", "updatedAt"]
    },
    "supportTickets": {
      "title": "Support Ticket",
      "description": "User support inquiries, content reports, and issue tickets",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["bug", "content_report", "contact", "question", "other"] },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 3000 },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "closed"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["ticketId", "userId", "userEmail", "userName", "type", "subject", "message", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "User profiles"
    },
    "/churches/{churchId}": {
      "schema": { "$ref": "#/entities/churches" },
      "description": "Church communities"
    },
    "/churchMembers/{membershipId}": {
      "schema": { "$ref": "#/entities/churchMembers" },
      "description": "Memberships in churches"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/notifications" },
      "description": "Community and admin notifications"
    },
    "/needs/{needId}": {
      "schema": { "$ref": "#/entities/needs" },
      "description": "Community requests and needs"
    },
    "/needs/{needId}/responses/{responseId}": {
      "schema": { "$ref": "#/entities/needResponses" },
      "description": "User responses/proposals to needs"
    },
    "/resources/{resourceId}": {
      "schema": { "$ref": "#/entities/resources" },
      "description": "Community resources and offers"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/events" },
      "description": "Community events"
    },
    "/eventParticipants/{participantId}": {
      "schema": { "$ref": "#/entities/eventParticipants" },
      "description": "Registrations for community events"
    },
    "/collaborations/{collaborationId}": {
      "schema": { "$ref": "#/entities/collaborations" },
      "description": "Inter-church collaborations"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/posts" },
      "description": "Community posts and announcements"
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/comments" },
      "description": "Comments on community posts"
    },
    "/opportunities/{opportunityId}": {
      "schema": { "$ref": "#/entities/opportunities" },
      "description": "Professional opportunities and services"
    },
    "/opportunityResponses/{responseId}": {
      "schema": { "$ref": "#/entities/opportunityResponses" },
      "description": "User applications and interest in opportunities"
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/supportTickets" },
      "description": "Support tickets and content reports"
    }
  }
}
