rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Core Helper Functions
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isChurchOwnerOrAdmin(churchId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/churches/$(churchId)) && (
          get(/databases/$(database)/documents/churches/$(churchId)).data.createdBy == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/churches/$(churchId)).data.leaderIds
        )) ||
        (exists(/databases/$(database)/documents/churchMembers/$(churchId + '_' + request.auth.uid)) &&
         get(/databases/$(database)/documents/churchMembers/$(churchId + '_' + request.auth.uid)).data.status == 'approved' &&
         get(/databases/$(database)/documents/churchMembers/$(churchId + '_' + request.auth.uid)).data.role in ['OWNER', 'ADMIN'])
      );
    }

    function isApprovedChurchMember(churchId) {
      return isSignedIn() && exists(/databases/$(database)/documents/churchMembers/$(churchId + '_' + request.auth.uid)) &&
        get(/databases/$(database)/documents/churchMembers/$(churchId + '_' + request.auth.uid)).data.status == 'approved';
    }

    // -------------------------------------------------------------
    // 1. User Profiles & Public Projections
    // -------------------------------------------------------------
    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 150)) &&
             (!('availability' in data) || (data.availability is string && data.availability.size() <= 100)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
             (!('skills' in data) || data.skills is list) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1048576)) &&
             (!('coverPhotoUrl' in data) || (data.coverPhotoUrl is string && data.coverPhotoUrl.size() <= 1048576));
    }

    match /users/{userId} {
      allow get: if isAuthUser(userId) || isAdmin();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthUser(userId) && isValidUser(incoming()) && incoming().userId == request.auth.uid;
      allow update: if (isAuthUser(userId) || isAdmin()) && isValidUser(incoming()) &&
                       incoming().userId == existing().userId &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if isAuthUser(userId) || isAdmin();
    }

    match /publicProfiles/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAuthUser(userId) && incoming().userId == request.auth.uid;
      allow delete: if isAuthUser(userId) || isAdmin();
    }

    // -------------------------------------------------------------
    // 2. Churches & Secrets
    // -------------------------------------------------------------
    function isValidChurch(data) {
      return data.churchId is string && data.churchId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.city is string && data.city.size() <= 100 &&
             data.country is string && data.country.size() <= 100 &&
             data.createdBy is string && data.createdBy.size() <= 128 &&
             data.leaderIds is list && data.leaderIds.size() > 0 && data.leaderIds.size() <= 20 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('website' in data) || (data.website is string && data.website.size() <= 150));
    }

    match /churches/{churchId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidChurch(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().leaderIds == [request.auth.uid] &&
                       incoming().verificationStatus in ['pending', 'verified'];
      allow update: if (isChurchOwnerOrAdmin(churchId) || isAdmin()) && isValidChurch(incoming()) &&
                       incoming().churchId == existing().churchId &&
                       incoming().createdBy == existing().createdBy &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if isAdmin() || (isSignedIn() && existing().createdBy == request.auth.uid);
    }

    match /churchSecrets/{churchId} {
      allow get: if isChurchOwnerOrAdmin(churchId) || isAdmin();
      allow list: if false;
      allow create: if isSignedIn() &&
                       (existsAfter(/databases/$(database)/documents/churches/$(churchId)) || isChurchOwnerOrAdmin(churchId)) &&
                       incoming().churchId == churchId &&
                       incoming().joinCode is string && incoming().joinCode.size() <= 50;
      allow update: if (isChurchOwnerOrAdmin(churchId) || isAdmin()) &&
                       incoming().churchId == existing().churchId &&
                       incoming().joinCode is string && incoming().joinCode.size() <= 50;
      allow delete: if isChurchOwnerOrAdmin(churchId) || isAdmin();
    }

    // -------------------------------------------------------------
    // 3. Church Memberships
    // -------------------------------------------------------------
    function isValidChurchMember(data) {
      return data.membershipId is string && data.membershipId.size() <= 256 &&
             data.churchId is string && data.churchId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['OWNER', 'ADMIN', 'MEMBER'] &&
             data.status in ['pending', 'approved', 'rejected', 'left', 'removed'];
    }

    match /churchMembers/{membershipId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isChurchOwnerOrAdmin(resource.data.churchId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isChurchOwnerOrAdmin(resource.data.churchId) || isAdmin());
      allow create: if isSignedIn() && isValidChurchMember(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       (
                         (incoming().role == 'MEMBER') ||
                         (incoming().role == 'OWNER' && incoming().status == 'approved')
                       );
      allow update: if isSignedIn() && isValidChurchMember(incoming()) &&
                       incoming().membershipId == existing().membershipId &&
                       incoming().userId == existing().userId &&
                       incoming().churchId == existing().churchId &&
                       (
                         isChurchOwnerOrAdmin(existing().churchId) ||
                         isAdmin() ||
                         (existing().userId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                          incoming().status in ['left'])
                       );
      allow delete: if isSignedIn() && (
        isChurchOwnerOrAdmin(existing().churchId) ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
    }

    // -------------------------------------------------------------
    // 4. Needs (Demandes) & Responses
    // -------------------------------------------------------------
    function isValidNeed(data) {
      return data.needId is string && data.needId.size() <= 128 &&
             data.createdBy is string && data.createdBy.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.quantity is number && data.quantity > 0 &&
             data.status in ['open', 'partially_fulfilled', 'fulfilled', 'cancelled', 'expired'] &&
             data.visibility in ['public', 'church', 'private'];
    }

    match /needs/{needId} {
      allow get, list: if isSignedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.visibility == 'church' && isApprovedChurchMember(resource.data.churchId)) ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidNeed(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().needId == needId;
      allow update: if (existing().createdBy == request.auth.uid || isAdmin()) && isValidNeed(incoming()) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().needId == existing().needId &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if existing().createdBy == request.auth.uid || isAdmin();

      match /responses/{responseId} {
        allow get, list: if isSignedIn() && (
          resource.data.responderId == request.auth.uid ||
          resource.data.needAuthorId == request.auth.uid ||
          get(/databases/$(database)/documents/needs/$(needId)).data.createdBy == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSignedIn() && incoming().responderId == request.auth.uid &&
                         incoming().quantityProposed is number && incoming().quantityProposed > 0;
        allow update: if isSignedIn() && (
          (existing().needAuthorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status in ['accepted', 'rejected']) ||
          (existing().responderId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'withdrawn') ||
          isAdmin()
        );
        allow delete: if existing().responderId == request.auth.uid || isAdmin();
      }
    }

    match /needResponses/{responseId} {
      allow get, list: if isSignedIn() && (
        resource.data.responderId == request.auth.uid ||
        resource.data.needAuthorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().responderId == request.auth.uid &&
                       incoming().quantityProposed is number && incoming().quantityProposed > 0;
      allow update: if isSignedIn() && (
        (existing().needAuthorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status in ['accepted', 'rejected']) ||
        (existing().responderId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'withdrawn') ||
        isAdmin()
      );
      allow delete: if existing().responderId == request.auth.uid || isAdmin();
    }

    // -------------------------------------------------------------
    // 5. Resources (Offres & Matériels)
    // -------------------------------------------------------------
    function isValidResource(data) {
      return data.resourceId is string && data.resourceId.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.ownerType in ['user', 'church'] &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.quantity is number && data.quantity > 0 &&
             data.status in ['available', 'reserved', 'unavailable', 'closed'];
    }

    match /resources/{resourceId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidResource(incoming()) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().resourceId == resourceId;
      allow update: if (existing().ownerId == request.auth.uid || isAdmin() || (existing().ownerType == 'church' && isChurchOwnerOrAdmin(existing().churchId))) &&
                       isValidResource(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().resourceId == existing().resourceId &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if existing().ownerId == request.auth.uid || isAdmin() || (existing().ownerType == 'church' && isChurchOwnerOrAdmin(existing().churchId));
    }

    // -------------------------------------------------------------
    // 6. Collaborations
    // -------------------------------------------------------------
    function isValidCollaboration(data) {
      return data.collaborationId is string && data.collaborationId.size() <= 128 &&
             data.needId is string && data.needId.size() <= 128 &&
             data.resourceId is string && data.resourceId.size() <= 128 &&
             data.needOwnerId is string && data.needOwnerId.size() <= 128 &&
             data.resourceOwnerId is string && data.resourceOwnerId.size() <= 128 &&
             data.quantity is number && data.quantity > 0 &&
             data.status in ['draft', 'proposed', 'accepted', 'active', 'completed', 'cancelled', 'rejected', 'archived'] &&
             data.message is string && data.message.size() <= 3000;
    }

    match /collaborations/{collaborationId} {
      allow get, list: if isSignedIn() && (
        resource.data.needOwnerId == request.auth.uid ||
        resource.data.resourceOwnerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidCollaboration(incoming()) &&
                       (incoming().needOwnerId == request.auth.uid || incoming().resourceOwnerId == request.auth.uid) &&
                       incoming().status == 'proposed';
      allow update: if isSignedIn() && isValidCollaboration(incoming()) &&
                       incoming().collaborationId == existing().collaborationId &&
                       incoming().needOwnerId == existing().needOwnerId &&
                       incoming().resourceOwnerId == existing().resourceOwnerId &&
                       incoming().needId == existing().needId &&
                       incoming().resourceId == existing().resourceId &&
                       (existing().needOwnerId == request.auth.uid || existing().resourceOwnerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 7. Events & Event Participants
    // -------------------------------------------------------------
    function isValidEvent(data) {
      return data.eventId is string && data.eventId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 3000 &&
             data.category is string && data.category.size() <= 100 &&
             data.organizerId is string && data.organizerId.size() <= 128 &&
             data.organizerType in ['user', 'church'] &&
             data.location is string && data.location.size() <= 250 &&
             data.visibility in ['public', 'church', 'private'] &&
             data.status in ['draft', 'published', 'cancelled', 'completed'];
    }

    match /events/{eventId} {
      allow get, list: if isSignedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.organizerId == request.auth.uid ||
        (resource.data.visibility == 'church' && isApprovedChurchMember(resource.data.churchId)) ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidEvent(incoming()) &&
                       incoming().organizerId == request.auth.uid &&
                       incoming().eventId == eventId &&
                       (incoming().organizerType != 'church' || isChurchOwnerOrAdmin(incoming().churchId));
      allow update: if (existing().organizerId == request.auth.uid || (existing().organizerType == 'church' && isChurchOwnerOrAdmin(existing().churchId)) || isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['registeredCount', 'updatedAt'])) &&
                       isValidEvent(incoming()) &&
                       incoming().organizerId == existing().organizerId &&
                       incoming().eventId == existing().eventId &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if existing().organizerId == request.auth.uid || (existing().organizerType == 'church' && isChurchOwnerOrAdmin(existing().churchId)) || isAdmin();
    }

    match /eventParticipants/{participantId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/events/$(resource.data.eventId)) &&
         get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.organizerId == request.auth.uid)
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid &&
                       incoming().status == 'registered';
      allow update: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/events/$(existing().eventId)) &&
         get(/databases/$(database)/documents/events/$(existing().eventId)).data.organizerId == request.auth.uid) ||
        isAdmin()
      ) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if existing().userId == request.auth.uid || isAdmin();
    }

    // -------------------------------------------------------------
    // 8. Community Posts & Comments
    // -------------------------------------------------------------
    function isValidPost(data) {
      return data.postId is string && data.postId.size() <= 128 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 5000 &&
             data.visibility in ['public', 'church', 'private'] &&
             data.status in ['published', 'archived'];
    }

    match /posts/{postId} {
      allow get, list: if isSignedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.authorId == request.auth.uid ||
        (resource.data.visibility == 'church' && isApprovedChurchMember(resource.data.churchId)) ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidPost(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().postId == postId;
      allow update: if isSignedIn() && (
        (existing().authorId == request.auth.uid && isValidPost(incoming()) && incoming().authorId == existing().authorId && incoming().postId == existing().postId) ||
        (existing().churchId != null && isChurchOwnerOrAdmin(existing().churchId)) ||
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'commentCount', 'updatedAt']))
      );
      allow delete: if existing().authorId == request.auth.uid || (existing().churchId != null && isChurchOwnerOrAdmin(existing().churchId)) || isAdmin();
    }

    match /comments/{commentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid &&
                       incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 2000;
      allow update: if (existing().authorId == request.auth.uid || isAdmin()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 2000;
      allow delete: if existing().authorId == request.auth.uid || isAdmin();
    }

    // -------------------------------------------------------------
    // 9. Opportunities & Opportunity Responses
    // -------------------------------------------------------------
    function isValidOpportunity(data) {
      return data.opportunityId is string && data.opportunityId.size() <= 128 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.type in ['service', 'job', 'volunteer', 'skill_request'] &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 5000 &&
             data.visibility in ['public', 'church', 'private'] &&
             data.status in ['open', 'closed', 'filled', 'cancelled'];
    }

    match /opportunities/{opportunityId} {
      allow get, list: if isSignedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.authorId == request.auth.uid ||
        (resource.data.visibility == 'church' && isApprovedChurchMember(resource.data.churchId)) ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidOpportunity(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().opportunityId == opportunityId;
      allow update: if isSignedIn() && (
        (existing().authorId == request.auth.uid && isValidOpportunity(incoming()) && incoming().authorId == existing().authorId) ||
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['responseCount', 'updatedAt']))
      );
      allow delete: if existing().authorId == request.auth.uid || isAdmin();
    }

    match /opportunityResponses/{responseId} {
      allow get, list: if isSignedIn() && (
        resource.data.responderId == request.auth.uid ||
        resource.data.opportunityAuthorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().responderId == request.auth.uid &&
                       incoming().message is string && incoming().message.size() <= 2000 &&
                       incoming().status == 'pending';
      allow update: if isSignedIn() && (
        (existing().opportunityAuthorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status in ['accepted', 'rejected']) ||
        (existing().responderId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'withdrawn') ||
        isAdmin()
      );
      allow delete: if existing().responderId == request.auth.uid || isAdmin();
    }

    // -------------------------------------------------------------
    // 10. Direct Contact Requests (Replacing fake opportunity IDs)
    // -------------------------------------------------------------
    function isValidContactRequest(data) {
      return data.requestId is string && data.requestId.size() <= 128 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.recipientId is string && data.recipientId.size() <= 128 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 3000 &&
             data.status in ['pending', 'accepted', 'declined', 'read', 'cancelled'];
    }

    match /contactRequests/{requestId} {
      allow get, list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidContactRequest(incoming()) &&
                       incoming().senderId == request.auth.uid &&
                       incoming().status == 'pending';
      allow update: if isSignedIn() && (
        (existing().recipientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status in ['accepted', 'declined', 'read']) ||
        (existing().senderId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'cancelled') ||
        isAdmin()
      );
      allow delete: if existing().senderId == request.auth.uid || isAdmin();
    }

    // -------------------------------------------------------------
    // 11. Notifications
    // -------------------------------------------------------------
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       incoming().notificationId is string &&
                       incoming().userId is string &&
                       incoming().title is string && incoming().title.size() <= 200 &&
                       incoming().body is string && incoming().body.size() <= 1000;
      allow update: if isSignedIn() && existing().userId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------
    // 12. Support Tickets & Issue Reports
    // -------------------------------------------------------------
    function isValidSupportTicket(data) {
      return data.ticketId is string && data.ticketId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 256 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 3000 &&
             data.status in ['open', 'in_progress', 'resolved', 'closed'];
    }

    match /supportTickets/{ticketId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidSupportTicket(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'open';
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 13. System Admins & Test Endpoint
    // -------------------------------------------------------------
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
  }
}
