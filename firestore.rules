rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email == 'altruiste2.0.4@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Collections
    
    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (
        resource == null || 
        !('privacySettings' in resource.data) || 
        !('profileVisibility' in resource.data.privacySettings) || 
        resource.data.privacySettings.profileVisibility != 'private' || 
        isOwner(userId) || 
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Churches
    match /churches/{churchId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Add more checks later
      allow delete: if isAdmin();
    }

    // Church Memberships
    match /churchMembers/{membershipId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Needs (Demandes)
    match /needs/{needId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource == null || resource.data.createdBy == request.auth.uid);
      allow delete: if isSignedIn() && (resource == null || resource.data.createdBy == request.auth.uid || isAdmin());

      match /responses/{responseId} {
        allow get, list, create, update, delete: if isSignedIn();
      }
    }

    // Resources (Offres)
    match /resources/{resourceId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // Events
    match /events/{eventId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Event Participants
    match /eventParticipants/{participantId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Collaborations
    match /collaborations/{collaborationId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow list: if isSignedIn();
      allow get, create, update, delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Community Posts
    match /posts/{postId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Comments
    match /comments/{commentId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Opportunities
    match /opportunities/{opportunityId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /opportunityResponses/{responseId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Support Tickets & Content Reports
    match /supportTickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow get, list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Admins
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
  }
}
